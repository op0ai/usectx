{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "usectx",
  "version": "0.3.1",
  "description": "usectx Memory kit: attach hosted MCP, session lease, hop, extract. Tokens stay out of mcp.json.",
  "author": {
