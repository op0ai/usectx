{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node ./hooks/usectx-hook.mjs sessionStart"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node ./hooks/usectx-hook.mjs beforeSubmitPrompt",
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node ./hooks/usectx-hook.mjs beforeMCPExecution",
        "failClosed": true
      }
    ],
    "sessionEnd": [
      {
        "command": "node ./hooks/usectx-hook.mjs sessionEnd"
      }
    ]
  }
}
