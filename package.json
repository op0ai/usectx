{
  "name": "usectx",
  "private": true,
  "version": "0.3.0-dev",
  "description": "usectx — leased workspace Memory + MCP door on Evokoa pgGraph/pgContext engines",
  "workspaces": ["packages/*"],
  "catalog": {
    "effect": "4.0.0-rc.112",
    "alchemy": "2.0.0-beta.74",
    "typescript": "7.0.2",
    "vite-plus": "0.3.0"
  },
  "usectxEnginePins": {
    "pggraph": "1.2.0",
    "pgcontext": "0.3.0",
    "graphify": "0.9.53",
    "graphifyNote": "Graphify-Labs CLI/tool pin (not an npm catalog dep); see docs/sota-gap.md"
  },
  "scripts": {
    "build": "bun run --filter '@op0/*' build",
    "typecheck": "bun run --filter '@op0/*' typecheck",
    "ctx:doctor": "bun run --filter @op0/ctx doctor",
    "ctx:http": "bun run --filter @op0/ctx http",
    "ctx:inspect": "bun run --filter @op0/ctx inspect",
    "kit:readyz": "./bin/usectx readyz",
    "kit:inspect": "./bin/usectx inspect"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "@types/node": "^22.13.10"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.4.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/op0ai/usectx"
  },
  "homepage": "https://github.com/op0ai/usectx"
}
